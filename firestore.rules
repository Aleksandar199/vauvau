rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin is granted via users/{uid}.role == 'admin' (set in Firestore).
    // Do not hardcode a placeholder email here — rotate via the users doc.
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Update helpers (only valid inside update rules: need `resource`) ---

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function changed(key) {
      return key in affected();
    }

    function onlyChanged(keys) {
      return affected().hasOnly(keys);
    }

    // List `after` = `before` plus exactly the caller's uid.
    function addedSelf(before, after) {
      return after is list &&
        !(request.auth.uid in before) &&
        after.size() == before.size() + 1 &&
        after.toSet() == before.toSet().union([request.auth.uid].toSet());
    }

    // List `after` = `before` minus exactly the caller's uid.
    function removedSelf(before, after) {
      return after is list &&
        request.auth.uid in before &&
        after.size() == before.size() - 1 &&
        after.toSet() == before.toSet().difference([request.auth.uid].toSet());
    }

    // Caller added exactly their own uid to the array `field`.
    function selfJoined(field) {
      return addedSelf(resource.data.get(field, []),
        request.resource.data.get(field, []));
    }

    // Caller removed exactly their own uid from the array `field`.
    function selfLeft(field) {
      return removedSelf(resource.data.get(field, []),
        request.resource.data.get(field, []));
    }

    // Like / unlike: only `field` changes, by the caller's own uid.
    function ownToggle(field) {
      return onlyChanged([field]) && (selfJoined(field) || selfLeft(field));
    }

    // Chat message reactions are stored in `likes`: a bare uid is ❤️, other
    // emoji are 'uid:emoji' (mirrors messageReactionEmojis in
    // lib/core/utils/message_reactions.dart).
    function myReactionEntries() {
      let u = request.auth.uid;
      return [u, u + ':👍', u + ':😂', u + ':😮', u + ':😢', u + ':🙏', u + ':❤️'];
    }

    // Only `field` changes, only in the caller's own entry, and the caller
    // keeps at most one reaction; nobody else's reaction is touched.
    function ownReaction(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      let mine = myReactionEntries().toSet();
      return onlyChanged([field]) &&
        after is list &&
        after.size() == after.toSet().size() &&
        after.toSet().difference(before.toSet()).difference(mine).size() == 0 &&
        before.toSet().difference(after.toSet()).difference(mine).size() == 0 &&
        after.toSet().intersection(mine).size() <= 1;
    }

    // Counter `field` changed by exactly ±1 (missing counts as 0).
    function stepByOne(field) {
      return request.resource.data[field] is int &&
        (request.resource.data[field] - resource.data.get(field, 0)) in [1, -1];
    }

    // Inbox preview: short string (client clips to 200 runes) and a server
    // timestamp for its time field, so nobody can pin a chat to the top.
    function previewOk(timeField) {
      return (
        !changed('lastMessage') || (
          request.resource.data.lastMessage is string &&
          request.resource.data.lastMessage.size() <= 1000
        )
      ) && (
        !changed(timeField) || request.resource.data[timeField] == request.time
      );
    }

    // `lastMessage*` preview written by a member after posting to the chat.
    function lastMessageOk(membersField) {
      return (
        !changed('lastMessage') &&
        !changed('lastMessageAt') &&
        !changed('lastMessageSenderId')
      ) || (
        request.auth.uid in request.resource.data.get(membersField, []) &&
        previewOk('lastMessageAt') &&
        (!changed('lastMessageSenderId') ||
          request.resource.data.lastMessageSenderId == request.auth.uid)
      );
    }

    // Two distinct uids incl. the caller; doc id is `sortedUid0_sortedUid1`.
    function isSortedPair(docId, ids) {
      return ids is list &&
        ids.size() == 2 &&
        request.auth.uid in ids &&
        (
          (ids[0] < ids[1] && docId == ids[0] + '_' + ids[1]) ||
          (ids[1] < ids[0] && docId == ids[1] + '_' + ids[0])
        );
    }

    // Notification sender = caller; recipient has not blocked the caller;
    // bounded text, unread, server time (no spam, no faked ordering).
    function notificationOk(toUid) {
      let d = request.resource.data;
      return d.fromUserId == request.auth.uid &&
        toUid is string &&
        d.get('isRead', false) == false &&
        d.createdAt == request.time &&
        d.get('title', '') is string && d.get('title', '').size() <= 500 &&
        d.get('body', '') is string && d.get('body', '').size() <= 1000 &&
        d.get('message', '') is string && d.get('message', '').size() <= 1000 &&
        (
          toUid == request.auth.uid ||
          !exists(/databases/$(database)/documents/users/$(toUid)/blocked_users/$(request.auth.uid))
        );
    }

    // Must live in users/{uid}/private/account, never on the public profile
    // (mirrors userPrivateFields in lib/features/auth/data/user_document.dart).
    function userPrivateFields() {
      return [
        'email',
        'fcmToken',
        'fcmTokenUpdatedAt',
        'contentReports',
        'placeChangeRequests',
        'isWalking',
        'walkStatus',
        'walkStartedAt',
        'lastKnownLocation',
        'geohash',
        'latitude',
        'longitude',
      ];
    }

    // Admin reads all private docs (reports list, user emails).
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    match /users/{userId} {
      // Public profile: every signed-in user may read it.
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && !request.resource.data.keys().hasAny(userPrivateFields());
      // Legacy private fields may only be removed, never added or changed.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().toSet()
          .intersection(affected())
          .intersection(userPrivateFields().toSet())
          .size() == 0;
      allow update: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // email, FCM token, own location, own reports: owner + admin only.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
        allow read, update: if isAdmin();
      }

      match /fcmInbox/{msgId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated() && notificationOk(userId);
      }

      match /blocked_users/{blockedUserId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Map place corrections saved under the reporter until top-level
      // change_requests rules are deployed everywhere.
      match /place_change_requests/{requestId} {
        allow create: if isOwner(userId)
          && request.resource.data.reportedByUserId == request.auth.uid
          && request.resource.data.status == 'pending';
        allow read: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Completed walk sessions (duration + distance) for the owner.
      match /walks/{walkId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() &&
        (resource.data.toUserId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() &&
        notificationOk(request.resource.data.toUserId) &&
        request.resource.data.get('recipientId', request.resource.data.toUserId) ==
          request.resource.data.toUserId;
    }

    // --- Dog like counters ---------------------------------------------------
    // likesCount == number of dogs/{dogId}/likes/{uid} docs; superLikesCount ==
    // number of super_likes/{uid}_{dogId} markers. A counter may change only
    // in the same batch as the caller's own like doc / marker, by exactly ±1,
    // so nobody can inflate it by repeating likes or super likes.
    function dogPath(dogId) {
      return /databases/$(database)/documents/dogs/$(dogId);
    }

    function myLikePath(dogId) {
      return /databases/$(database)/documents/dogs/$(dogId)/likes/$(request.auth.uid);
    }

    function mySuperMarkerPath(dogId) {
      return /databases/$(database)/documents/super_likes/$(request.auth.uid + '_' + dogId);
    }

    // `delta` must equal after-state minus before-state of the flag.
    function stepMatches(delta, before, after) {
      return (before == after && delta == 0) ||
        (!before && after && delta == 1) ||
        (before && !after && delta == -1);
    }

    function dogCountersMatch(dogId, dLikes, dSuper) {
      return stepMatches(dLikes,
          exists(myLikePath(dogId)), existsAfter(myLikePath(dogId))) &&
        stepMatches(dSuper,
          exists(mySuperMarkerPath(dogId)), existsAfter(mySuperMarkerPath(dogId)));
    }

    // Same check from the like doc / marker side (dog exists before + after).
    function dogCountersMatchAfter(dogId) {
      let before = get(dogPath(dogId)).data;
      let after = getAfter(dogPath(dogId)).data;
      return dogCountersMatch(
        dogId,
        after.get('likesCount', 0) - before.get('likesCount', 0),
        after.get('superLikesCount', 0) - before.get('superLikesCount', 0)
      );
    }

    // Marker id = {fromUserId}_{targetDogId}: one counted super like per user
    // per dog. Legacy auto-id docs are not markers and may just be deleted.
    match /super_likes/{superLikeId} {
      allow read: if isAuthenticated() &&
        (resource == null ||
          resource.data.fromUserId == request.auth.uid ||
          resource.data.targetOwnerId == request.auth.uid ||
          isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.targetDogId is string &&
        superLikeId == request.auth.uid + '_' + request.resource.data.targetDogId &&
        request.resource.data.createdAt == request.time &&
        dogCountersMatchAfter(request.resource.data.targetDogId);
      allow delete: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid &&
        (
          superLikeId != request.auth.uid + '_' + resource.data.targetDogId ||
          !exists(dogPath(resource.data.targetDogId)) ||
          dogCountersMatchAfter(resource.data.targetDogId)
        );
      allow update, delete: if isAdmin();
    }

    match /pois/{poiId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Dynamic map cities (Novi Sad, Beograd, …).
    match /cities/{cityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin-managed places (also mirrored into pois for map markers).
    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Map place corrections from the community (hours, closed, location…).
    match /change_requests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reportedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.placeId is string &&
        request.resource.data.changeType is string;
      allow read, update, delete: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reportedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /support/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dogs/{dogId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      // Owner edits the dog but not its like counters; admin anything.
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        !changed('likesCount') &&
        !changed('superLikesCount');
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
      // Likers: counters only, matching their like doc / super-like marker.
      allow update: if isAuthenticated() &&
        onlyChanged(['likesCount', 'superLikesCount']) &&
        dogCountersMatch(
          dogId,
          request.resource.data.get('likesCount', 0) -
            resource.data.get('likesCount', 0),
          request.resource.data.get('superLikesCount', 0) -
            resource.data.get('superLikesCount', 0)
        );

      match /likes/{userId} {
        allow read: if isAuthenticated();
        // Liker writes their own like doc + dog counters in the same batch.
        allow create, update: if isOwner(userId) &&
          request.resource.data.type in ['like', 'superLike'] &&
          dogCountersMatchAfter(dogId);
        allow delete: if isOwner(userId) &&
          (!exists(dogPath(dogId)) || dogCountersMatchAfter(dogId));
        // Dog owner cleans up likes when deleting the dog / account.
        allow delete: if isAuthenticated() &&
          get(dogPath(dogId)).data.ownerId == request.auth.uid;
      }

      match /health_records/{recordId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/dogs/$(dogId)).data.ownerId ==
            request.auth.uid;
        allow read, write: if isAdmin();
      }

      match /reminders/{reminderId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/dogs/$(dogId)).data.ownerId ==
            request.auth.uid;
        allow read, write: if isAdmin();
      }
    }

    match /chats/{chatId} {
      // Entry `p` of unreadByUser: caller may reset own count to 0 (or drop it
      // when leaving); a peer's count may only go up by exactly 1 (new message).
      function unreadEntryOk(p, before, after, keys) {
        return !(p in keys) ||
          (p == request.auth.uid &&
            (!(p in after) || after[p] == 0)) ||
          (p != request.auth.uid &&
            after.get(p, 0) == before.get(p, 0) + 1);
      }

      function unreadByUserOk() {
        let ps = resource.data.participantIds;
        let before = resource.data.get('unreadByUser', {});
        let after = request.resource.data.get('unreadByUser', {});
        let keys = after.diff(before).affectedKeys();
        return !changed('unreadByUser') || (
          after is map &&
          keys.hasOnly(ps) &&
          unreadEntryOk(ps[0], before, after, keys) &&
          (ps.size() < 2 || unreadEntryOk(ps[1], before, after, keys))
        );
      }

      // A missing room may be probed (create-if-absent); it reveals nothing.
      allow read: if isAuthenticated() &&
        (resource == null || request.auth.uid in resource.data.participantIds);
      // 1:1 room: exactly the caller + one peer, id = sortedUid0_sortedUid1.
      allow create: if isAuthenticated() &&
        isSortedPair(chatId, request.resource.data.participantIds);
      // Only existing participants may update, and only the inbox fields:
      // preview, unread counters, isNewMatch → false, or leaving. Room
      // metadata (names, photos, dogIds) is fixed at create. participantIds
      // may keep the same members or drop the caller only (account deletion).
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds &&
        onlyChanged([
          'participantIds',
          'unreadByUser',
          'unreadCount',
          'lastMessage',
          'lastMessageTimestamp',
          'isNewMatch',
        ]) &&
        (
          request.resource.data.participantIds.toSet() ==
            resource.data.participantIds.toSet() ||
          selfLeft('participantIds')
        ) &&
        previewOk('lastMessageTimestamp') &&
        unreadByUserOk() &&
        (!changed('unreadCount') || request.resource.data.unreadCount == 0) &&
        (!changed('isNewMatch') || request.resource.data.isNewMatch == false);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        // Peer may accept/decline a walk invite (status only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          resource.data.type == 'walk_invite' &&
          request.auth.uid != resource.data.senderId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['accepted', 'declined'];
        // Participants may react to any message (own entry in likes only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          ownReaction('likes');
        // Sender may delete own messages (account deletion cascade).
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      // Caller must be one of the two matched users; id = sortedUid0_sortedUid1.
      allow create: if isAuthenticated() &&
        isSortedPair(matchId, request.resource.data.userIds);
      // Re-match after unlike/like does set-merge on the existing doc.
      allow update: if isAuthenticated() &&
        resource.data.userIds is list &&
        request.auth.uid in resource.data.userIds &&
        request.resource.data.userIds.toSet() == resource.data.userIds.toSet();
      allow delete: if isAuthenticated() &&
        (
          (resource.data.userIds is list &&
            request.auth.uid in resource.data.userIds) ||
          (resource.data.participantIds is list &&
            request.auth.uid in resource.data.participantIds)
        );
      allow update, delete: if isAdmin();
    }

    match /swipes/{swipeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /adoption_dogs/{dogId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uploaderUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.uploaderUserId;
      allow update, delete: if isAdmin();
    }

    match /lost_dogs/{dogId} {
      // Exactly one comment appended at the end, authored by the caller.
      function lostDogCommentAppended() {
        let before = resource.data.get('comments', []);
        let after = request.resource.data.comments;
        let added = after[after.size() - 1];
        return after is list &&
          after.size() == before.size() + 1 &&
          after[0:before.size()] == before &&
          added.authorUserId == request.auth.uid &&
          added.text is string &&
          added.text.size() > 0 &&
          added.text.size() <= 2000 &&
          added.authorName is string &&
          added.authorName.size() <= 100;
      }

      function commentLikeToggled() {
        let k = request.resource.data.commentLikeTarget;
        let before = resource.data.get('commentLikes', {});
        let after = request.resource.data.commentLikes;
        return k is string &&
          after is map &&
          after.diff(before).affectedKeys().hasOnly([k]) &&
          (
            addedSelf(before.get(k, []), after.get(k, [])) ||
            removedSelf(before.get(k, []), after.get(k, []))
          );
      }

      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uploaderUserId == request.auth.uid;
      // Owner or admin may update (e.g. mark resolved).
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.uploaderUserId || isAdmin());
      // Anyone signed in may append one sighting comment as themselves:
      // existing comments stay identical (no rewriting others' text) and
      // commentsCount goes up by exactly 1.
      allow update: if isAuthenticated() &&
        onlyChanged(['comments', 'commentsCount']) &&
        lostDogCommentAppended() &&
        request.resource.data.commentsCount ==
          resource.data.get('commentsCount', 0) + 1;
      // Comment likes: map commentId -> [uids]. The caller toggles only their
      // own uid in the single entry named by commentLikeTarget.
      allow update: if isAuthenticated() &&
        onlyChanged(['commentLikes', 'commentLikeTarget']) &&
        commentLikeToggled();
      // Only admins may permanently delete listings.
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.authorUserId == request.auth.uid;
        allow update: if isAuthenticated() &&
          ownToggle('likes');
        allow update, delete: if isAuthenticated() &&
          resource.data.authorUserId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /breed_groups/{groupId} {
      // memberIds unchanged (count too), or caller joined/left with count ±1.
      function groupMembershipOk() {
        let count = resource.data.get(
          'memberCount',
          resource.data.get('memberIds', []).size()
        );
        return (!changed('memberIds') && !changed('memberCount')) ||
          (selfJoined('memberIds') &&
            request.resource.data.memberCount == count + 1) ||
          (selfLeft('memberIds') &&
            request.resource.data.memberCount == count - 1);
      }

      allow read: if isAuthenticated();
      // User-created groups must be pending (isApproved == false) with the
      // creator as the only member. Approved / seed groups: admin only.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll([
          'title',
          'description',
          'memberIds',
          'memberCount',
          'isApproved',
          'createdBy',
        ]) &&
        (
          (
            request.resource.data.isApproved == false &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.memberIds == [request.auth.uid] &&
            request.resource.data.memberCount == 1
          ) ||
          isAdmin()
        );
      // Creator may edit own group details (not createdBy / isApproved /
      // membership); admin anything. Everyone (creator too): join/leave
      // themselves (memberIds + memberCount ±1) and the lastMessage* preview
      // after posting as a member.
      allow update: if isAuthenticated() &&
        (
          (
            resource.data.get('createdBy', '') == request.auth.uid &&
            !changed('createdBy') &&
            !changed('isApproved') &&
            !changed('memberIds') &&
            !changed('memberCount') &&
            lastMessageOk('memberIds')
          ) ||
          (
            onlyChanged([
              'memberIds',
              'memberCount',
              'lastMessage',
              'lastMessageAt',
              'lastMessageSenderId',
            ]) &&
            groupMembershipOk() &&
            lastMessageOk('memberIds')
          ) ||
          isAdmin()
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds &&
          request.resource.data.senderId == request.auth.uid;
        // Members may accept/decline group walk invites.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds &&
          resource.data.type == 'walk_invite' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedByUserIds', 'declinedByUserIds', 'status']);
        // Members may react to any message (own entry in likes only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds &&
          ownReaction('likes');
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /members/{userId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      // Organizer = caller, sole initial participant, never pre-approved.
      allow create: if isAuthenticated() &&
        (
          (
            request.resource.data.organizerUserId == request.auth.uid &&
            request.resource.data.participantUserIds == [request.auth.uid] &&
            request.resource.data.get('isApproved', false) == false
          ) ||
          isAdmin()
        );
      // Organizer may edit own event details (not organizerUserId / isApproved
      // / participants); admin anything. Everyone: join/leave themselves and
      // the lastMessage* preview.
      allow update: if isAuthenticated() &&
        (
          (
            resource.data.get('organizerUserId', '') == request.auth.uid &&
            !changed('organizerUserId') &&
            !changed('isApproved') &&
            !changed('participantUserIds') &&
            lastMessageOk('participantUserIds')
          ) ||
          (
            onlyChanged([
              'participantUserIds',
              'lastMessage',
              'lastMessageAt',
              'lastMessageSenderId',
            ]) &&
            (
              !changed('participantUserIds') ||
              selfJoined('participantUserIds') ||
              selfLeft('participantUserIds')
            ) &&
            lastMessageOk('participantUserIds')
          ) ||
          isAdmin()
        );
      allow delete: if isAuthenticated() &&
        resource.data.organizerUserId == request.auth.uid;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds &&
          request.resource.data.senderId == request.auth.uid;
        // Participants may accept/decline event walk invites.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds &&
          resource.data.type == 'walk_invite' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedByUserIds', 'declinedByUserIds', 'status']);
        // Participants may react to any message (own entry in likes only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds &&
          ownReaction('likes');
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /members/{userId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /admin_feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Field is authorUserId in the app (not authorId).
    match /moments/{momentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.authorUserId == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.resource.data.authorUserId == resource.data.authorUserId &&
        (resource.data.authorUserId == request.auth.uid || isAdmin() ||
          ownToggle('likes') ||
          (onlyChanged(['commentsCount']) && stepByOne('commentsCount')));
      allow delete: if isAuthenticated() &&
        (resource.data.authorUserId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.authorUserId == request.auth.uid;
        allow update: if isAuthenticated() &&
          ownToggle('likes');
        allow update, delete: if isAuthenticated() &&
          resource.data.authorUserId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // Highlights are stored on dogs/{dogId}.storyHighlights (owner update
    // rules on /dogs cover writes). Kept for any legacy top-level docs.
    match /highlights/{highlightId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 40 &&
        request.resource.data.momentIds is list;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.dogId == resource.data.dogId &&
        request.resource.data.title.size() <= 40;
      allow delete: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
