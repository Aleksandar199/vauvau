rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin is granted via users/{uid}.role == 'admin' (set in Firestore).
    // Do not hardcode a placeholder email here — rotate via the users doc.
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Update helpers (only valid inside update rules: need `resource`) ---

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function changed(key) {
      return key in affected();
    }

    function onlyChanged(keys) {
      return affected().hasOnly(keys);
    }

    // List `after` = `before` plus exactly the caller's uid.
    function addedSelf(before, after) {
      return after is list &&
        !(request.auth.uid in before) &&
        after.size() == before.size() + 1 &&
        after.toSet() == before.toSet().union([request.auth.uid].toSet());
    }

    // List `after` = `before` minus exactly the caller's uid.
    function removedSelf(before, after) {
      return after is list &&
        request.auth.uid in before &&
        after.size() == before.size() - 1 &&
        after.toSet() == before.toSet().difference([request.auth.uid].toSet());
    }

    // Caller added exactly their own uid to the array `field`.
    function selfJoined(field) {
      return addedSelf(resource.data.get(field, []),
        request.resource.data.get(field, []));
    }

    // Caller removed exactly their own uid from the array `field`.
    function selfLeft(field) {
      return removedSelf(resource.data.get(field, []),
        request.resource.data.get(field, []));
    }

    // Like / unlike: only `field` changes, by the caller's own uid.
    function ownToggle(field) {
      return onlyChanged([field]) && (selfJoined(field) || selfLeft(field));
    }

    // Chat message reactions are stored in `likes`: a bare uid is ❤️, other
    // emoji are 'uid:emoji' (mirrors messageReactionEmojis in
    // lib/core/utils/message_reactions.dart).
    function myReactionEntries() {
      let u = request.auth.uid;
      return [u, u + ':👍', u + ':😂', u + ':😮', u + ':😢', u + ':🙏', u + ':❤️'];
    }

    // Only `field` changes, only in the caller's own entry, and the caller
    // keeps at most one reaction; nobody else's reaction is touched.
    function ownReaction(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      let mine = myReactionEntries().toSet();
      return onlyChanged([field]) &&
        after is list &&
        after.size() == after.toSet().size() &&
        after.toSet().difference(before.toSet()).difference(mine).size() == 0 &&
        before.toSet().difference(after.toSet()).difference(mine).size() == 0 &&
        after.toSet().intersection(mine).size() <= 1;
    }

    // Counter `field` changed by exactly ±1 (missing counts as 0).
    function stepByOne(field) {
      return request.resource.data[field] is int &&
        (request.resource.data[field] - resource.data.get(field, 0)) in [1, -1];
    }

    // Inbox preview: short string (client clips to 200 runes) and a server
    // timestamp for its time field, so nobody can pin a chat to the top.
    function previewOk(timeField) {
      return (
        !changed('lastMessage') || (
          request.resource.data.lastMessage is string &&
          request.resource.data.lastMessage.size() <= 1000
        )
      ) && (
        !changed(timeField) || request.resource.data[timeField] == request.time
      );
    }

    // `lastMessage*` preview written by a member after posting to the chat.
    function lastMessageOk(membersField) {
      return (
        !changed('lastMessage') &&
        !changed('lastMessageAt') &&
        !changed('lastMessageSenderId')
      ) || (
        request.auth.uid in request.resource.data.get(membersField, []) &&
        previewOk('lastMessageAt') &&
        (!changed('lastMessageSenderId') ||
          request.resource.data.lastMessageSenderId == request.auth.uid)
      );
    }

    // Two distinct uids incl. the caller; doc id is `sortedUid0_sortedUid1`.
    function isSortedPair(docId, ids) {
      return ids is list &&
        ids.size() == 2 &&
        request.auth.uid in ids &&
        (
          (ids[0] < ids[1] && docId == ids[0] + '_' + ids[1]) ||
          (ids[1] < ids[0] && docId == ids[1] + '_' + ids[0])
        );
    }

    // Notification sender = caller; recipient has not blocked the caller;
    // bounded text, unread, server time (no spam, no faked ordering).
    function notificationOk(toUid) {
      let d = request.resource.data;
      return d.fromUserId == request.auth.uid &&
        toUid is string &&
        d.get('isRead', false) == false &&
        d.createdAt == request.time &&
        d.get('title', '') is string && d.get('title', '').size() <= 500 &&
        d.get('body', '') is string && d.get('body', '').size() <= 1000 &&
        d.get('message', '') is string && d.get('message', '').size() <= 1000 &&
        (
          toUid == request.auth.uid ||
          !exists(/databases/$(database)/documents/users/$(toUid)/blocked_users/$(request.auth.uid))
        );
    }

    // Must live in users/{uid}/private/account, never on the public profile
    // (mirrors userPrivateFields in lib/features/auth/data/user_document.dart).
    function userPrivateFields() {
      return [
        'email',
        'fcmToken',
        'fcmTokenUpdatedAt',
        'contentReports',
        'placeChangeRequests',
        'isWalking',
        'walkStatus',
        'walkStartedAt',
        'lastKnownLocation',
        'geohash',
        'latitude',
        'longitude',
      ];
    }

    // Admin reads all private docs (reports list, user emails).
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    match /users/{userId} {
      // Public profile: every signed-in user may read it.
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && !request.resource.data.keys().hasAny(userPrivateFields());
      // Legacy private fields may only be removed, never added or changed.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().toSet()
          .intersection(affected())
          .intersection(userPrivateFields().toSet())
          .size() == 0;
      allow update: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // email, FCM token, own location, own reports: owner + admin only.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
        allow read, update: if isAdmin();
      }

      match /fcmInbox/{msgId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated() && notificationOk(userId);
      }

      match /blocked_users/{blockedUserId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Map place corrections saved under the reporter until top-level
      // change_requests rules are deployed everywhere.
      match /place_change_requests/{requestId} {
        allow create: if isOwner(userId)
          && request.resource.data.reportedByUserId == request.auth.uid
          && request.resource.data.status == 'pending';
        allow read: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Completed walks (+ precise route) – owner only, never public.
      // Immutable for the owner: the reward is recomputed from this record.
      match /walks/{walkId} {
        allow read, create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
      }

      // XP / points: summary + day (d{key}) / week (w{key}) progress. Only
      // written together with a NEW ledger entry that matches the change.
      match /rewards/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
          (docId == 'summary' ? summaryWriteOk(userId) : progressWriteOk(userId, docId));
        // Cleanup only after the public profile is deleted (account deletion).
        allow delete: if isAdmin() || (isOwner(userId) && !exists(userDocPath(userId)));
      }

      // Immutable log of every balance change; deterministic ids make a
      // repeated request (same walk / challenge period / coupon) fail.
      match /reward_ledger/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && ledgerEntryOk(userId, entryId);
        allow delete: if isAdmin() || (isOwner(userId) && !exists(userDocPath(userId)));
      }
    }

    // --- Rewards (Dnevni VauVau izazov) -------------------------------------
    // No Cloud Functions (Spark plan): the client writes, the rules recompute
    // and cross-check every number (RewardRules in lib/features/rewards/domain/
    // reward_rules.dart – keep the constants in sync). They CANNOT prove that
    // a walk really happened: a modified client can still submit a fake but
    // plausible walk; the daily km cap limits what that is worth.

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function rewardPath(uid, docId) {
      return /databases/$(database)/documents/users/$(uid)/rewards/$(docId);
    }

    function ledgerPath(uid, entryId) {
      return /databases/$(database)/documents/users/$(uid)/reward_ledger/$(entryId);
    }

    function couponPath(couponId) {
      return /databases/$(database)/documents/reward_coupons/$(couponId);
    }

    function claimPath(couponId, uid) {
      return /databases/$(database)/documents/coupon_claims/$(couponId + '_' + uid);
    }

    function newLedgerEntry(uid, entryId) {
      return entryId is string &&
        !exists(ledgerPath(uid, entryId)) &&
        existsAfter(ledgerPath(uid, entryId));
    }

    // Europe/Belgrade offset (mirrors BelgradeCalendar): UTC+2 from the last
    // Sunday of March 01:00 UTC to the last Sunday of October 01:00 UTC.
    function belgradeOffsetH(t) {
      let m = t.month();
      let d = t.day();
      let s = d - (t.dayOfWeek() % 7);
      let pastSwitch = s >= 25 && (d > s || t.hours() >= 1);
      return ((m > 3 && m < 10) || (m == 3 && pastSwitch) || (m == 10 && !pastSwitch)) ? 2 : 1;
    }

    function dayKeyOf(l) {
      return l.year() * 10000 + l.month() * 100 + l.day();
    }

    function belgradeDayKey(t) {
      return dayKeyOf(t + duration.value(belgradeOffsetH(t), 'h'));
    }

    // Day key of the Monday of the Belgrade week.
    function belgradeWeekKey(t) {
      let l = t + duration.value(belgradeOffsetH(t), 'h');
      return dayKeyOf(l - duration.value(l.dayOfWeek() - 1, 'd'));
    }

    // summary: deltas == the one new ledger entry; points never negative.
    function summaryWriteOk(uid) {
      let d = request.resource.data;
      let e = getAfter(ledgerPath(uid, d.lastEntryId)).data;
      let oldXp = resource == null ? 0 : resource.data.get('xp', 0);
      let oldPoints = resource == null ? 0 : resource.data.get('points', 0);
      return d.keys().hasOnly(['xp', 'points', 'lastEntryId', 'updatedAt']) &&
        newLedgerEntry(uid, d.lastEntryId) &&
        d.xp is int && d.points is int &&
        d.xp == oldXp + e.xp &&
        d.points == oldPoints + e.points &&
        d.points >= 0 &&
        d.updatedAt == request.time;
    }

    // Day/week progress: only beside a new walk entry for this period (the
    // walk entry rule checks the numbers).
    function progressWriteOk(uid, docId) {
      let d = request.resource.data;
      let e = getAfter(ledgerPath(uid, d.lastEntryId)).data;
      return d.keys().hasOnly(['meters', 'walks', 'walkPoints', 'lastEntryId', 'updatedAt']) &&
        newLedgerEntry(uid, d.lastEntryId) &&
        e.type == 'walk' &&
        (docId == 'd' + string(e.dayKey) || docId == 'w' + string(e.weekKey)) &&
        d.updatedAt == request.time;
    }

    function ledgerEntryOk(uid, entryId) {
      let e = request.resource.data;
      return e.createdAt == request.time &&
        e.xp is int && e.points is int &&
        e.reason is string && e.reason.size() <= 200 &&
        getAfter(rewardPath(uid, 'summary')).data.lastEntryId == entryId &&
        (
          (e.type == 'walk' && walkEntryOk(uid, entryId, e)) ||
          (e.type == 'challenge' && challengeEntryOk(uid, entryId, e)) ||
          (e.type == 'coupon' && couponEntryOk(uid, entryId, e))
        );
    }

    function periodBefore(uid, docId) {
      return exists(rewardPath(uid, docId))
        ? get(rewardPath(uid, docId)).data
        : {'meters': 0, 'walks': 0, 'walkPoints': 0};
    }

    function periodAdded(before, after, meters, counted, pts, entryId) {
      return after.meters == before.get('meters', 0) + meters &&
        after.walks == before.get('walks', 0) + counted &&
        after.walkPoints == before.get('walkPoints', 0) + pts &&
        after.lastEntryId == entryId;
    }

    // Walk reward = 5 per whole recognized km, at most 30 per Belgrade day
    // (RewardRules.pointsPerKm / dailyKmPointsCap), only for a plausible
    // walk (≤ 7 km/h average, ≤ 4 h) that ended within the last 48 h.
    function walkEntryOk(uid, entryId, e) {
      let w = getAfter(/databases/$(database)/documents/users/$(uid)/walks/$(e.walkId)).data;
      let dayId = 'd' + string(e.dayKey);
      let weekId = 'w' + string(e.weekKey);
      let dayB = periodBefore(uid, dayId);
      let weekB = periodBefore(uid, weekId);
      let km = math.floor(w.recognizedMeters / 1000);
      let room = 30 - dayB.get('walkPoints', 0);
      let pts = km * 5 < room ? km * 5 : room;
      let counted = km >= 1 ? 1 : 0;
      return entryId == 'walk_' + e.walkId &&
        e.keys().hasOnly(['type', 'walkId', 'km', 'dayKey', 'weekKey', 'xp', 'points', 'reason', 'createdAt']) &&
        w.recognizedMeters is int && w.recognizedMeters >= 100 && w.recognizedMeters <= 40000 &&
        w.durationSeconds is int && w.durationSeconds > 0 && w.durationSeconds <= 14400 &&
        w.recognizedMeters * 3600 <= w.durationSeconds * 7000 &&
        w.startedAt is timestamp && w.endedAt is timestamp &&
        w.endedAt.toMillis() - w.startedAt.toMillis() >= w.durationSeconds * 1000 - 5000 &&
        w.endedAt <= request.time + duration.value(5, 'm') &&
        w.endedAt > request.time - duration.value(48, 'h') &&
        e.dayKey == belgradeDayKey(w.endedAt) &&
        e.weekKey == belgradeWeekKey(w.endedAt) &&
        e.km == km && e.points == pts && e.xp == pts &&
        periodAdded(dayB, getAfter(rewardPath(uid, dayId)).data, w.recognizedMeters, counted, pts, entryId) &&
        periodAdded(weekB, getAfter(rewardPath(uid, weekId)).data, w.recognizedMeters, counted, pts, entryId);
    }

    // Challenge bonus = the admin-set amounts, once per challenge per period
    // (entry id), only when the period's progress meets the target, for the
    // current or a recent period.
    function challengeEntryOk(uid, entryId, e) {
      let c = get(/databases/$(database)/documents/reward_challenges/$(e.challengeId)).data;
      let daily = c.period == 'daily';
      let p = get(rewardPath(uid, (daily ? 'd' : 'w') + string(e.periodKey))).data;
      let earliest = request.time - duration.value(48, 'h');
      return entryId == 'ch_' + e.challengeId + '_' + string(e.periodKey) &&
        e.keys().hasOnly(['type', 'challengeId', 'periodKey', 'xp', 'points', 'reason', 'createdAt']) &&
        c.isActive == true &&
        e.xp == c.rewardXp && e.points == c.rewardPoints &&
        e.periodKey is int &&
        e.periodKey <= (daily ? belgradeDayKey(request.time) : belgradeWeekKey(request.time)) &&
        e.periodKey >= (daily ? belgradeDayKey(earliest) : belgradeWeekKey(earliest)) &&
        (c.metric == 'distance' ? p.meters >= c.target * 1000 : p.walks >= c.target);
    }

    // Coupon purchase: exactly -price, together with the caller's new claim.
    function couponEntryOk(uid, entryId, e) {
      let c = get(couponPath(e.couponId)).data;
      return entryId == 'coupon_' + e.couponId &&
        e.keys().hasOnly(['type', 'couponId', 'xp', 'points', 'reason', 'createdAt']) &&
        e.xp == 0 && e.points == -c.pointsCost &&
        !exists(claimPath(e.couponId, uid)) &&
        existsAfter(claimPath(e.couponId, uid));
    }

    // Admin review of all points across users.
    match /{path=**}/reward_ledger/{entryId} {
      allow read: if isAdmin();
    }

    match /reward_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Partner coupons: admin manages; a claim may only bump claimedCount by 1
    // (never above maxQuantity, only while active and in date range) in the
    // same write as the caller's new claim document.
    match /reward_coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      allow update: if isAuthenticated() &&
        onlyChanged(['claimedCount']) &&
        resource.data.isActive == true &&
        request.time >= resource.data.startsAt &&
        request.time < resource.data.expiresAt &&
        request.resource.data.claimedCount == resource.data.get('claimedCount', 0) + 1 &&
        request.resource.data.claimedCount <= resource.data.maxQuantity &&
        !exists(claimPath(couponId, request.auth.uid)) &&
        existsAfter(claimPath(couponId, request.auth.uid));
    }

    // A user's coupon: id {couponId}_{uid} (one per user per offer), random
    // code, paid by the matching ledger entry. The user may only mark it
    // redeemed (one way); admin may redeem or cancel. Nobody deletes it.
    match /coupon_claims/{claimId} {
      allow read: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && couponClaimOk(claimId);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'claimed' &&
        onlyChanged(['status', 'redeemedAt']) &&
        request.resource.data.status == 'redeemed' &&
        request.resource.data.redeemedAt == request.time;
      allow update: if isAdmin() &&
        resource.data.status == 'claimed' &&
        onlyChanged(['status', 'redeemedAt', 'cancelledAt']) &&
        request.resource.data.status in ['redeemed', 'cancelled'];
    }

    function couponClaimOk(claimId) {
      let d = request.resource.data;
      let before = get(couponPath(d.couponId)).data;
      let after = getAfter(couponPath(d.couponId)).data;
      return claimId == d.couponId + '_' + request.auth.uid &&
        d.keys().hasOnly(['userId', 'couponId', 'code', 'status', 'pointsCost',
          'partnerName', 'title', 'discountLabel', 'expiresAt', 'claimedAt']) &&
        d.userId == request.auth.uid &&
        d.status == 'claimed' &&
        d.claimedAt == request.time &&
        d.code is string && d.code.matches('^VV-[A-HJ-NP-Z2-9]{8}$') &&
        d.pointsCost == before.pointsCost &&
        d.expiresAt == before.expiresAt &&
        after.claimedCount == before.get('claimedCount', 0) + 1 &&
        existsAfter(ledgerPath(request.auth.uid, 'coupon_' + d.couponId));
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() &&
        (resource.data.toUserId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() &&
        notificationOk(request.resource.data.toUserId) &&
        request.resource.data.get('recipientId', request.resource.data.toUserId) ==
          request.resource.data.toUserId;
    }

    // --- Dog like counters ---------------------------------------------------
    // likesCount == number of dogs/{dogId}/likes/{uid} docs; superLikesCount ==
    // number of super_likes/{uid}_{dogId} markers. A counter may change only
    // in the same batch as the caller's own like doc / marker, by exactly ±1,
    // so nobody can inflate it by repeating likes or super likes.
    function dogPath(dogId) {
      return /databases/$(database)/documents/dogs/$(dogId);
    }

    function myLikePath(dogId) {
      return /databases/$(database)/documents/dogs/$(dogId)/likes/$(request.auth.uid);
    }

    function mySuperMarkerPath(dogId) {
      return /databases/$(database)/documents/super_likes/$(request.auth.uid + '_' + dogId);
    }

    // `delta` must equal after-state minus before-state of the flag.
    function stepMatches(delta, before, after) {
      return (before == after && delta == 0) ||
        (!before && after && delta == 1) ||
        (before && !after && delta == -1);
    }

    function dogCountersMatch(dogId, dLikes, dSuper) {
      return stepMatches(dLikes,
          exists(myLikePath(dogId)), existsAfter(myLikePath(dogId))) &&
        stepMatches(dSuper,
          exists(mySuperMarkerPath(dogId)), existsAfter(mySuperMarkerPath(dogId)));
    }

    // Same check from the like doc / marker side (dog exists before + after).
    function dogCountersMatchAfter(dogId) {
      let before = get(dogPath(dogId)).data;
      let after = getAfter(dogPath(dogId)).data;
      return dogCountersMatch(
        dogId,
        after.get('likesCount', 0) - before.get('likesCount', 0),
        after.get('superLikesCount', 0) - before.get('superLikesCount', 0)
      );
    }

    // Marker id = {fromUserId}_{targetDogId}: one counted super like per user
    // per dog. Legacy auto-id docs are not markers and may just be deleted.
    match /super_likes/{superLikeId} {
      allow read: if isAuthenticated() &&
        (resource == null ||
          resource.data.fromUserId == request.auth.uid ||
          resource.data.targetOwnerId == request.auth.uid ||
          isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.targetDogId is string &&
        superLikeId == request.auth.uid + '_' + request.resource.data.targetDogId &&
        request.resource.data.createdAt == request.time &&
        dogCountersMatchAfter(request.resource.data.targetDogId);
      allow delete: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid &&
        (
          superLikeId != request.auth.uid + '_' + resource.data.targetDogId ||
          !exists(dogPath(resource.data.targetDogId)) ||
          dogCountersMatchAfter(resource.data.targetDogId)
        );
      allow update, delete: if isAdmin();
    }

    match /pois/{poiId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Dynamic map cities (Novi Sad, Beograd, …).
    match /cities/{cityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin-managed places (also mirrored into pois for map markers).
    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Map place corrections from the community (hours, closed, location…).
    match /change_requests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reportedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.placeId is string &&
        request.resource.data.changeType is string;
      allow read, update, delete: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reportedByUserId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /support/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dogs/{dogId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      // Owner edits the dog but not its like counters; admin anything.
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        !changed('likesCount') &&
        !changed('superLikesCount');
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
      // Likers: counters only, matching their like doc / super-like marker.
      allow update: if isAuthenticated() &&
        onlyChanged(['likesCount', 'superLikesCount']) &&
        dogCountersMatch(
          dogId,
          request.resource.data.get('likesCount', 0) -
            resource.data.get('likesCount', 0),
          request.resource.data.get('superLikesCount', 0) -
            resource.data.get('superLikesCount', 0)
        );

      match /likes/{userId} {
        allow read: if isAuthenticated();
        // Liker writes their own like doc + dog counters in the same batch.
        allow create, update: if isOwner(userId) &&
          request.resource.data.type in ['like', 'superLike'] &&
          dogCountersMatchAfter(dogId);
        allow delete: if isOwner(userId) &&
          (!exists(dogPath(dogId)) || dogCountersMatchAfter(dogId));
        // Dog owner cleans up likes when deleting the dog / account.
        allow delete: if isAuthenticated() &&
          get(dogPath(dogId)).data.ownerId == request.auth.uid;
      }

      match /health_records/{recordId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/dogs/$(dogId)).data.ownerId ==
            request.auth.uid;
        allow read, write: if isAdmin();
      }

      match /reminders/{reminderId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/dogs/$(dogId)).data.ownerId ==
            request.auth.uid;
        allow read, write: if isAdmin();
      }
    }

    match /chats/{chatId} {
      // Entry `p` of unreadByUser: caller may reset own count to 0 (or drop it
      // when leaving); a peer's count may only go up by exactly 1 (new message).
      function unreadEntryOk(p, before, after, keys) {
        return !(p in keys) ||
          (p == request.auth.uid &&
            (!(p in after) || after[p] == 0)) ||
          (p != request.auth.uid &&
            after.get(p, 0) == before.get(p, 0) + 1);
      }

      function unreadByUserOk() {
        let ps = resource.data.participantIds;
        let before = resource.data.get('unreadByUser', {});
        let after = request.resource.data.get('unreadByUser', {});
        let keys = after.diff(before).affectedKeys();
        return !changed('unreadByUser') || (
          after is map &&
          keys.hasOnly(ps) &&
          unreadEntryOk(ps[0], before, after, keys) &&
          (ps.size() < 2 || unreadEntryOk(ps[1], before, after, keys))
        );
      }

      // A missing room may be probed (create-if-absent); it reveals nothing.
      allow read: if isAuthenticated() &&
        (resource == null || request.auth.uid in resource.data.participantIds);
      // 1:1 room: exactly the caller + one peer, id = sortedUid0_sortedUid1.
      allow create: if isAuthenticated() &&
        isSortedPair(chatId, request.resource.data.participantIds);
      // Only existing participants may update, and only the inbox fields:
      // preview, unread counters, isNewMatch → false, or leaving. Room
      // metadata (names, photos, dogIds) is fixed at create. participantIds
      // may keep the same members or drop the caller only (account deletion).
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds &&
        onlyChanged([
          'participantIds',
          'unreadByUser',
          'unreadCount',
          'lastMessage',
          'lastMessageTimestamp',
          'isNewMatch',
        ]) &&
        (
          request.resource.data.participantIds.toSet() ==
            resource.data.participantIds.toSet() ||
          selfLeft('participantIds')
        ) &&
        previewOk('lastMessageTimestamp') &&
        unreadByUserOk() &&
        (!changed('unreadCount') || request.resource.data.unreadCount == 0) &&
        (!changed('isNewMatch') || request.resource.data.isNewMatch == false);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
        // Peer may accept/decline a walk invite (status only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          resource.data.type == 'walk_invite' &&
          request.auth.uid != resource.data.senderId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['accepted', 'declined'];
        // Participants may react to any message (own entry in likes only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          ownReaction('likes');
        // Sender may delete own messages (account deletion cascade).
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      // Caller must be one of the two matched users; id = sortedUid0_sortedUid1.
      allow create: if isAuthenticated() &&
        isSortedPair(matchId, request.resource.data.userIds);
      // Re-match after unlike/like does set-merge on the existing doc.
      allow update: if isAuthenticated() &&
        resource.data.userIds is list &&
        request.auth.uid in resource.data.userIds &&
        request.resource.data.userIds.toSet() == resource.data.userIds.toSet();
      allow delete: if isAuthenticated() &&
        (
          (resource.data.userIds is list &&
            request.auth.uid in resource.data.userIds) ||
          (resource.data.participantIds is list &&
            request.auth.uid in resource.data.participantIds)
        );
      allow update, delete: if isAdmin();
    }

    match /swipes/{swipeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /adoption_dogs/{dogId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uploaderUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.uploaderUserId;
      allow update, delete: if isAdmin();
    }

    match /lost_dogs/{dogId} {
      // Exactly one comment appended at the end, authored by the caller.
      function lostDogCommentAppended() {
        let before = resource.data.get('comments', []);
        let after = request.resource.data.comments;
        let added = after[after.size() - 1];
        return after is list &&
          after.size() == before.size() + 1 &&
          after[0:before.size()] == before &&
          added.authorUserId == request.auth.uid &&
          added.text is string &&
          added.text.size() > 0 &&
          added.text.size() <= 2000 &&
          added.authorName is string &&
          added.authorName.size() <= 100;
      }

      function commentLikeToggled() {
        let k = request.resource.data.commentLikeTarget;
        let before = resource.data.get('commentLikes', {});
        let after = request.resource.data.commentLikes;
        return k is string &&
          after is map &&
          after.diff(before).affectedKeys().hasOnly([k]) &&
          (
            addedSelf(before.get(k, []), after.get(k, [])) ||
            removedSelf(before.get(k, []), after.get(k, []))
          );
      }

      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uploaderUserId == request.auth.uid;
      // Owner or admin may update (e.g. mark resolved).
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.uploaderUserId || isAdmin());
      // Anyone signed in may append one sighting comment as themselves:
      // existing comments stay identical (no rewriting others' text) and
      // commentsCount goes up by exactly 1.
      allow update: if isAuthenticated() &&
        onlyChanged(['comments', 'commentsCount']) &&
        lostDogCommentAppended() &&
        request.resource.data.commentsCount ==
          resource.data.get('commentsCount', 0) + 1;
      // Comment likes: map commentId -> [uids]. The caller toggles only their
      // own uid in the single entry named by commentLikeTarget.
      allow update: if isAuthenticated() &&
        onlyChanged(['commentLikes', 'commentLikeTarget']) &&
        commentLikeToggled();
      // Only admins may permanently delete listings.
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.authorUserId == request.auth.uid;
        allow update: if isAuthenticated() &&
          ownToggle('likes');
        allow update, delete: if isAuthenticated() &&
          resource.data.authorUserId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /breed_groups/{groupId} {
      // memberIds unchanged (count too), or caller joined/left with count ±1.
      function groupMembershipOk() {
        let count = resource.data.get(
          'memberCount',
          resource.data.get('memberIds', []).size()
        );
        return (!changed('memberIds') && !changed('memberCount')) ||
          (selfJoined('memberIds') &&
            request.resource.data.memberCount == count + 1) ||
          (selfLeft('memberIds') &&
            request.resource.data.memberCount == count - 1);
      }

      allow read: if isAuthenticated();
      // User-created groups must be pending (isApproved == false) with the
      // creator as the only member. Approved / seed groups: admin only.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll([
          'title',
          'description',
          'memberIds',
          'memberCount',
          'isApproved',
          'createdBy',
        ]) &&
        (
          (
            request.resource.data.isApproved == false &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.memberIds == [request.auth.uid] &&
            request.resource.data.memberCount == 1
          ) ||
          isAdmin()
        );
      // Creator may edit own group details (not createdBy / isApproved /
      // membership); admin anything. Everyone (creator too): join/leave
      // themselves (memberIds + memberCount ±1) and the lastMessage* preview
      // after posting as a member.
      allow update: if isAuthenticated() &&
        (
          (
            resource.data.get('createdBy', '') == request.auth.uid &&
            !changed('createdBy') &&
            !changed('isApproved') &&
            !changed('memberIds') &&
            !changed('memberCount') &&
            lastMessageOk('memberIds')
          ) ||
          (
            onlyChanged([
              'memberIds',
              'memberCount',
              'lastMessage',
              'lastMessageAt',
              'lastMessageSenderId',
            ]) &&
            groupMembershipOk() &&
            lastMessageOk('memberIds')
          ) ||
          isAdmin()
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds &&
          request.resource.data.senderId == request.auth.uid;
        // Members may accept/decline group walk invites.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds &&
          resource.data.type == 'walk_invite' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedByUserIds', 'declinedByUserIds', 'status']);
        // Members may react to any message (own entry in likes only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/breed_groups/$(groupId)).data.memberIds &&
          ownReaction('likes');
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /members/{userId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      // Organizer = caller, sole initial participant, never pre-approved.
      allow create: if isAuthenticated() &&
        (
          (
            request.resource.data.organizerUserId == request.auth.uid &&
            request.resource.data.participantUserIds == [request.auth.uid] &&
            request.resource.data.get('isApproved', false) == false
          ) ||
          isAdmin()
        );
      // Organizer may edit own event details (not organizerUserId / isApproved
      // / participants); admin anything. Everyone: join/leave themselves and
      // the lastMessage* preview.
      allow update: if isAuthenticated() &&
        (
          (
            resource.data.get('organizerUserId', '') == request.auth.uid &&
            !changed('organizerUserId') &&
            !changed('isApproved') &&
            !changed('participantUserIds') &&
            lastMessageOk('participantUserIds')
          ) ||
          (
            onlyChanged([
              'participantUserIds',
              'lastMessage',
              'lastMessageAt',
              'lastMessageSenderId',
            ]) &&
            (
              !changed('participantUserIds') ||
              selfJoined('participantUserIds') ||
              selfLeft('participantUserIds')
            ) &&
            lastMessageOk('participantUserIds')
          ) ||
          isAdmin()
        );
      allow delete: if isAuthenticated() &&
        resource.data.organizerUserId == request.auth.uid;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds &&
          request.resource.data.senderId == request.auth.uid;
        // Participants may accept/decline event walk invites.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds &&
          resource.data.type == 'walk_invite' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedByUserIds', 'declinedByUserIds', 'status']);
        // Participants may react to any message (own entry in likes only).
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participantUserIds &&
          ownReaction('likes');
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /members/{userId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /admin_feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Field is authorUserId in the app (not authorId).
    match /moments/{momentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.authorUserId == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.resource.data.authorUserId == resource.data.authorUserId &&
        (resource.data.authorUserId == request.auth.uid || isAdmin() ||
          ownToggle('likes') ||
          (onlyChanged(['commentsCount']) && stepByOne('commentsCount')));
      allow delete: if isAuthenticated() &&
        (resource.data.authorUserId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.authorUserId == request.auth.uid;
        allow update: if isAuthenticated() &&
          ownToggle('likes');
        allow update, delete: if isAuthenticated() &&
          resource.data.authorUserId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // --- Follows ------------------------------------------------------------
    // follows/{followerUid}_{followedUid}: one owner account following
    // another. The id makes duplicates impossible; only create / delete.
    // Each side may read its own edges (my followers / who I follow); nobody
    // can list another user's followers.
    function followPath(followerUid, followedUid) {
      return /databases/$(database)/documents/follows/$(followerUid + '_' + followedUid);
    }

    match /follows/{followId} {
      // A missing edge may be probed by its follower (follow transaction).
      allow get: if isAuthenticated() &&
        (resource == null
          ? followId.split('_')[0] == request.auth.uid
          : request.auth.uid in [resource.data.followerUserId,
                                 resource.data.followedUserId]);
      allow list: if isAuthenticated() &&
        (resource.data.followerUserId == request.auth.uid ||
          resource.data.followedUserId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(
          ['followerUserId', 'followedUserId', 'createdAt']) &&
        request.resource.data.followerUserId == request.auth.uid &&
        request.resource.data.followedUserId is string &&
        request.resource.data.followedUserId.size() > 0 &&
        request.resource.data.followedUserId != request.auth.uid &&
        followId == request.auth.uid + '_' + request.resource.data.followedUserId &&
        request.resource.data.createdAt == request.time &&
        // No follow edge between users where either blocked the other
        // (storage.rules rely on this for follower-only story media).
        !exists(/databases/$(database)/documents/users/$(request.resource.data.followedUserId)/blocked_users/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_users/$(request.resource.data.followedUserId));
      // The follower unfollows; the followed person may remove a follower.
      allow delete: if isAuthenticated() &&
        (resource.data.followerUserId == request.auth.uid ||
          resource.data.followedUserId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- Stories (24h, audience) -------------------------------------------
    // audience: 'all' (Svi korisnici), 'followers' (Moji pratioci = who
    // follows the author), 'following' (Osobe koje ja pratim = whom the
    // author follows). The author is never audience-checked.
    function storyAudienceOk(d) {
      return d.authorUserId == request.auth.uid ||
        (
          !exists(/databases/$(database)/documents/users/$(d.authorUserId)/blocked_users/$(request.auth.uid)) &&
          (
            d.audience == 'all' ||
            (d.audience == 'followers' && exists(followPath(request.auth.uid, d.authorUserId))) ||
            (d.audience == 'following' && exists(followPath(d.authorUserId, request.auth.uid)))
          )
        );
    }

    // Single reads also need the story to be active. List queries cannot
    // check the expiry (rules cannot prove a range filter against
    // request.time), so the app always filters expiresAt > now, and media,
    // single reads and interactions are denied after expiry.
    function storyVisible(d) {
      return storyAudienceOk(d) &&
        (d.authorUserId == request.auth.uid || d.expiresAt > request.time);
    }

    function storyPath(storyId) {
      return /databases/$(database)/documents/stories/$(storyId);
    }

    // A viewer may interact: story active, visible to them, not their own.
    function canInteractWithStory(storyId) {
      let d = get(storyPath(storyId)).data;
      return d.authorUserId != request.auth.uid &&
        d.expiresAt > request.time &&
        storyAudienceOk(d);
    }

    function isStoryAuthor(storyId) {
      return get(storyPath(storyId)).data.authorUserId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow get: if isAuthenticated() && storyVisible(resource.data);
      allow list: if isAuthenticated() && storyAudienceOk(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'authorUserId', 'authorName', 'authorPhotoUrl',
          'dogId', 'dogName', 'dogPhotoUrl',
          'mediaType', 'mediaPath', 'caption', 'audience', 'status',
          'createdAt', 'expiresAt',
        ]) &&
        request.resource.data.authorUserId == request.auth.uid &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 80 &&
        request.resource.data.get('authorPhotoUrl', '') is string &&
        request.resource.data.get('authorPhotoUrl', '').size() <= 2048 &&
        request.resource.data.get('dogId', '') is string &&
        request.resource.data.get('dogName', '') is string &&
        request.resource.data.get('dogName', '').size() <= 80 &&
        request.resource.data.get('dogPhotoUrl', '') is string &&
        request.resource.data.get('dogPhotoUrl', '').size() <= 2048 &&
        request.resource.data.mediaType == 'image' &&
        request.resource.data.mediaPath ==
          'stories/' + request.auth.uid + '/' + storyId + '/media' &&
        request.resource.data.caption is string &&
        request.resource.data.caption.size() <= 500 &&
        request.resource.data.audience in ['all', 'followers', 'following'] &&
        request.resource.data.status == 'published' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        // 24h after publishing (client clock skew tolerated), never longer.
        request.resource.data.expiresAt > request.time + duration.value(22, 'h') &&
        request.resource.data.expiresAt < request.time + duration.value(26, 'h');
      // Stories are never edited after publishing.
      allow update: if false;
      allow delete: if isAuthenticated() &&
        (resource.data.authorUserId == request.auth.uid || isAdmin());

      // One view per viewer (doc id = viewer uid); only the author lists them.
      match /story_views/{viewerId} {
        allow get: if isAuthenticated() &&
          (viewerId == request.auth.uid || isStoryAuthor(storyId));
        allow list: if isAuthenticated() && isStoryAuthor(storyId);
        allow create: if isAuthenticated() &&
          viewerId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['viewerUserId', 'viewedAt', 'expiresAt']) &&
          request.resource.data.viewerUserId == request.auth.uid &&
          request.resource.data.viewedAt == request.time &&
          request.resource.data.expiresAt == get(storyPath(storyId)).data.expiresAt &&
          canInteractWithStory(storyId);
        allow delete: if isAuthenticated() &&
          (viewerId == request.auth.uid || isStoryAuthor(storyId) || isAdmin());
      }

      // One like per user (doc id = uid); only the author lists them.
      match /story_likes/{likerId} {
        allow get: if isAuthenticated() &&
          (likerId == request.auth.uid || isStoryAuthor(storyId));
        allow list: if isAuthenticated() && isStoryAuthor(storyId);
        allow create: if isAuthenticated() &&
          likerId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'createdAt', 'expiresAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.expiresAt == get(storyPath(storyId)).data.expiresAt &&
          canInteractWithStory(storyId);
        allow delete: if isAuthenticated() &&
          (likerId == request.auth.uid || isStoryAuthor(storyId) || isAdmin());
      }
    }

    // Highlights are stored on dogs/{dogId}.storyHighlights (owner update
    // rules on /dogs cover writes). Kept for any legacy top-level docs.
    match /highlights/{highlightId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 40 &&
        request.resource.data.momentIds is list;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.dogId == resource.data.dogId &&
        request.resource.data.title.size() <= 40;
      allow delete: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
