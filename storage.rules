rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images are shown via download URLs (?token=…), which bypass these
    // rules. Rules cover SDK/REST access by path: single objects of public
    // roots are readable, but only the owner may list a folder (no
    // enumeration of other users' uploads). Chat images: uploader only.
    // Writes require auth + image content type + max 8MB.
    // Deletes/writes are owner-scoped: {root}/{userId}/...
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function ownerImageWrite(userId) {
      return isOwner(userId) && isValidImage();
    }

    match /pets/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /moments/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /events/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /groups/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /adoption/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /lost_dogs/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    match /uploads/{userId}/{allPaths=**} {
      allow get: if true;
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    // Chat images: by path only the uploader (paths are guessable:
    // {uid}/{millis}). The peer loads the ?token= URL stored in the message,
    // which only chat participants can read in Firestore.
    match /chats/{userId}/{allPaths=**} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create, update: if ownerImageWrite(userId);
      allow delete: if isOwner(userId);
    }

    // Story media: stories/{uid}/{storyId}/media. Never handed out as a
    // ?token= URL by the app; every read goes through these rules, which
    // check the story document (cross-service): author, or active story +
    // audience + not blocked by the author. Upload once, never overwritten.
    function storyDoc(storyId) {
      return firestore.get(/databases/(default)/documents/stories/$(storyId)).data;
    }

    function followExists(followerUid, followedUid) {
      return firestore.exists(
        /databases/(default)/documents/follows/$(followerUid + '_' + followedUid));
    }

    function storyMediaReadable(userId, storyId) {
      let d = storyDoc(storyId);
      let me = request.auth.uid;
      return d.authorUserId == userId &&
        d.expiresAt > request.time &&
        !firestore.exists(
          /databases/(default)/documents/users/$(userId)/blocked_users/$(me)) &&
        (
          d.audience == 'all' ||
          (d.audience == 'followers' && followExists(me, userId)) ||
          (d.audience == 'following' && followExists(userId, me))
        );
    }

    match /stories/{userId}/{storyId}/{fileName} {
      allow get: if isOwner(userId) ||
        (isSignedIn() && storyMediaReadable(userId, storyId));
      allow list: if false;
      allow create: if ownerImageWrite(userId) && fileName == 'media' &&
        resource == null;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
