		     iz ios/Runner/GoogleService-Info.plist; zameniti kad se u Firebase-u
		     registruje iOS aplikacija com.vauvau.app (docs/ios_vodic.md, korak 4). -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.461477755452-eukch8env7hqe5d7jfcaf2c82fl2o8cr</string>
				</array>
			</dict>
		</array>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
